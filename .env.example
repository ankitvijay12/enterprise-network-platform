PROJECT_NAME="Enterprise Network Design & Simulation Platform"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Database: PostgreSQL in docker/production, SQLite for instant zero-dependency local dev
# SQLite local: sqlite:///./network_platform.db
# PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/enterprise_network_db
DATABASE_URL=sqlite:///./network_platform.db

# Security & JWT
SECRET_KEY=enterprise-secret-key-super-secure-change-in-production-2025-token
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
BACKEND_CORS_ORIGINS=["*"]

# Host & Port
HOST=0.0.0.0
PORT=8000
